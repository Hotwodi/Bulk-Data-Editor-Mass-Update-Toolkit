<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bde_update_template_tree" model="ir.ui.view">
        <field name="name">bde.update.template.tree</field>
        <field name="model">bde.update.template</field>
        <field name="arch" type="xml">
            <tree string="Update Templates" decoration-muted="not is_active">
                <field name="name"/>
                <field name="model_name"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="times_used"/>
                <field name="last_used"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bde_update_template_form" model="ir.ui.view">
        <field name="name">bde.update.template.form</field>
        <field name="model">bde.update.template</field>
        <field name="arch" type="xml">
            <form string="Update Template">
                <header>
                    <button name="action_apply_template" type="object" string="Create Job from Template" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1><field name="name" placeholder="e.g. Set partner active"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name" placeholder="e.g. res.partner"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="times_used" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Update Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="field_name"/>
                                    <field name="operation"/>
                                    <field name="value_type"/>
                                    <field name="value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bde_update_template" model="ir.actions.act_window">
        <field name="name">Update Templates</field>
        <field name="res_model">bde.update.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first update template
            </p>
            <p>
                Reusable templates let you quickly create bulk update jobs
                from predefined field operations.
            </p>
        </field>
    </record>
</odoo>
