<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bde_update_line_tree" model="ir.ui.view">
        <field name="name">bde.update.line.tree</field>
        <field name="model">bde.update.line</field>
        <field name="arch" type="xml">
            <tree string="Update Lines">
                <field name="field_name"/>
                <field name="operation"/>
                <field name="value_type"/>
                <field name="value"/>
                <field name="job_id"/>
                <field name="template_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bde_update_line_form" model="ir.ui.view">
        <field name="name">bde.update.line.form</field>
        <field name="model">bde.update.line</field>
        <field name="arch" type="xml">
            <form string="Update Line">
                <sheet>
                    <group>
                        <group>
                            <field name="field_name" placeholder="Technical field name, e.g. category_id"/>
                            <field name="operation"/>
                            <field name="value_type"/>
                        </group>
                        <group>
                            <field name="job_id"/>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <group string="Value">
                        <field name="value" placeholder="Enter value (for reference: model,id)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bde_update_line" model="ir.actions.act_window">
        <field name="name">Update Lines</field>
        <field name="res_model">bde.update.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
